#!/bin/bash
#PBS -N loopmulti
#PBS -q gpu
# mem=64gb is a ceiling, not a preference. The gpu queue carries
# resources_max.mem = 64gb and refuses anything above it at submit time
# with "Job violates queue and/or server resource limits". This line asked
# for 96gb, and never failed only because every real submission passed its
# own -l on the command line and overrode it. A bare
# "qsub scripts/multirun.pbs" would have been rejected outright.
# Re-check the cap with: qstat -Qf gpu | grep resources_max
#PBS -l select=1:ncpus=2:mem=48gb
#PBS -l walltime=168:00:00
#PBS -j oe

# Run several training runs inside ONE PBS job, each pinned to its own GPU.
#
#   RUNS="id1|cfg1|0 id2|cfg2|1 id3|cfg3|2 id4|cfg4|3" qsub scripts/multirun.pbs
#
# Each entry is run_id|config_path|seed, separated by spaces.
#
# WHY THIS EXISTS, because it looks like premature complexity otherwise.
#
# The binding constraint on this cluster is cores, not GPUs. On 2026-09-03
# the GPU node had 94 of 96 cores allocated while GPUs 2 and 5 sat at 0
# percent utilisation: the cards were idle because nothing had cores left
# to feed them. Submitting more PBS jobs does not help, they simply queue.
# Running more training processes inside a core allocation we already hold
# does.
#
# At ncpus=8 this launches four runs on four distinct cards with two cores
# each, where submit.pbs would have given two runs on two cards with four
# cores each. Same allocation, twice the throughput. Viable because at
# k around 10 the runs are GPU bound, not generation bound: one worker
# supplies roughly 4000 samples per second against a GPU consuming 1500 to
# 3000. See docs/decisions.md D-025.
#
# For a single run, use submit.pbs. This is for sweeps.

set -uo pipefail

cd "$PBS_O_WORKDIR"
mkdir -p logs

source /etc/profile.d/modules.sh
module load python311
source .venv/bin/activate

export RUNS="${RUNS:?RUNS must be set, as \"id|cfg|seed id|cfg|seed ...\"}"
export MAX_HOURS="${MAX_HOURS:-23.0}"
# PBS already knows which host the job was submitted from, so the login
# node is derived rather than hardcoded. That keeps the cluster name out
# of the repository and makes the chain work on any PBS site.
export CHAIN_SUBMIT_HOST="${CHAIN_SUBMIT_HOST:-${PBS_O_HOST%%.*}}"
: "${CHAIN_SUBMIT_HOST:?no submit host: set CHAIN_SUBMIT_HOST or check PBS_O_HOST}"
export PYTHONUNBUFFERED=1
export WANDB_MODE=offline

# Skip anything already finished, so a resubmitted sweep does not redo work.
PENDING=""
for entry in $RUNS; do
    rid="${entry%%|*}"
    if [ -f "runs/$rid/DONE" ]; then
        echo "skip $rid, already has DONE"
    else
        PENDING="$PENDING $entry"
    fi
done
PENDING=$(echo "$PENDING" | xargs || true)

if [ -z "$PENDING" ]; then
    echo "every run in this batch is already done, nothing to do"
    exit 0
fi

NRUNS=$(echo "$PENDING" | wc -w)
NCPUS="${NCPUS:-2}"
# One core for the trainer itself, the rest become generation workers.
PER_RUN=$(( NCPUS / NRUNS ))
[ "$PER_RUN" -lt 1 ] && PER_RUN=1
WORKERS=$(( PER_RUN - 1 ))
[ "$WORKERS" -lt 0 ] && WORKERS=0

# Release the GPU claims however this job ends, including the wall clock
# kill. A claim left behind blacklists a working card until the stale
# sweep catches it, which is a worse failure than the collision the claims
# exist to prevent, so the trap is set before anything can fail.
trap 'release_gpu_claims 2>/dev/null || true' EXIT TERM INT

N_GPUS="$NRUNS" source scripts/pick_gpus.sh || {
    echo "FATAL could not obtain GPUs for $NRUNS runs" >&2
    exit 1
}
GPUS=($LOOPVISION_GPUS)

echo "launching $NRUNS run(s), ${PER_RUN} core(s) and ${WORKERS} worker(s) each"
export OMP_NUM_THREADS="$PER_RUN"

PIDS=()
IDS=()
i=0
for entry in $PENDING; do
    rid="${entry%%|*}"
    rest="${entry#*|}"
    cfg="${rest%%|*}"
    seed="${rest##*|}"
    gpu="${GPUS[$(( i % ${#GPUS[@]} ))]}"

    echo "  -> $rid  config=$cfg  seed=$seed  GPU=$gpu"
    CUDA_VISIBLE_DEVICES="$gpu" \
        python -m loopvision.train.cli \
            --config "configs/${cfg}" \
            --run-id "$rid" \
            --seed "$seed" \
            --resume auto \
            --max-hours "$MAX_HOURS" \
            --num-workers "$WORKERS" \
            > "logs/${rid}.$PBS_JOBID.log" 2>&1 &
    PIDS+=($!)
    IDS+=("$rid")
    i=$(( i + 1 ))
done

# Wait for all, remembering who failed rather than taking the last status.
FAILED=""
for j in "${!PIDS[@]}"; do
    if ! wait "${PIDS[$j]}"; then
        FAILED="$FAILED ${IDS[$j]}"
    fi
done

echo "=== batch finished ==="
for rid in "${IDS[@]}"; do
    if [ -f "runs/$rid/DONE" ]; then echo "  $rid DONE"; else echo "  $rid INCOMPLETE"; fi
done

# Chain if anything is unfinished. Same login-node indirection as
# submit.pbs: this server refuses qsub from inside a running job.
REMAINING=""
for entry in $PENDING; do
    rid="${entry%%|*}"
    [ -f "runs/$rid/DONE" ] || REMAINING="$REMAINING $entry"
done
REMAINING=$(echo "$REMAINING" | xargs || true)

if [ -n "$REMAINING" ]; then
    echo "queueing successor for:$REMAINING"
    # Carry this job's allocation forward explicitly. Without the -l the
    # successor falls back to the header, and a job that was sized to fit a
    # two core gap resubmits itself asking for whatever the header says.
    # On a node where only small requests schedule, that successor never
    # runs and the chain dies silently holding a completed checkpoint.
    Q="qsub -W depend=afterany:$PBS_JOBID -l select=1:ncpus=${NCPUS}:mem=48gb -l walltime=168:00:00 -v RUNS=\"$REMAINING\",MAX_HOURS=$MAX_HOURS,NCPUS=$NCPUS scripts/multirun.pbs"
    set +e
    eval "$Q"
    rc=$?
    if [ $rc -ne 0 ]; then
        echo "direct qsub failed (rc=$rc), retrying via the login node"
        ssh -o BatchMode=yes -o StrictHostKeyChecking=no "$CHAIN_SUBMIT_HOST" \
            "cd '$PBS_O_WORKDIR' && $Q"
        rc=$?
    fi
    set -e
    if [ $rc -ne 0 ]; then
        echo "FATAL could not queue the successor. The sweep will not finish" >&2
        echo "on its own. Investigate rather than assuming it self-healed." >&2
        exit 1
    fi
fi

[ -n "$FAILED" ] && { echo "runs that exited non-zero:$FAILED" >&2; exit 1; }
exit 0
