#!/bin/bash
#PBS -N loopvis
#PBS -q gpu
#PBS -l select=1:ncpus=8:mem=48gb
#PBS -l walltime=24:00:00
#PBS -j oe

# Self-chaining training job.
#
# qalter is blocked on this cluster, so a running job cannot have its
# walltime extended and dies at the wall. The chain is how a run longer
# than 24 hours completes: each job stops itself an hour before the wall,
# checkpoints, and submits its own successor with a dependency on itself.
# The DONE sentinel is what breaks the loop.
#
#   RUN_ID=smoke01 ENTRY=loopvision.train.smoke qsub scripts/submit.pbs
#   RUN_ID=famA_384_v1 CONFIG=base.yaml qsub scripts/submit.pbs
#
# ncpus=8 is deliberate. The gpu queue caps a user at 16 concurrent cores,
# so 8 per job means two jobs run at once. Asking for more halves throughput.

set -euo pipefail

cd "$PBS_O_WORKDIR"
mkdir -p logs

# The venv is built against the python311 module, not the system python,
# which is 3.8 and too old for this project. Compute nodes do not inherit
# the login shell's module environment, so this load is required and its
# absence produces a confusing "python: command not found" or a silent
# fallback to 3.8.
source /etc/profile.d/modules.sh
module load python311

source .venv/bin/activate

# Exits non-zero if no card has enough free memory. Do not paper over this:
# starting anyway means dying on OOM hours later.
source scripts/pick_gpu.sh

export RUN_ID="${RUN_ID:?RUN_ID must be set}"
export ENTRY="${ENTRY:-loopvision.train.cli}"
# About an hour under the 24 hour walltime, so the process stops itself and
# checkpoints rather than being killed mid-step. Overridable so the chain
# itself can be tested without waiting a day per link.
export MAX_HOURS="${MAX_HOURS:-23.0}"
# Login node used to submit the successor job, see the chain block below.
export CHAIN_SUBMIT_HOST="${CHAIN_SUBMIT_HOST:-<login-node>}"
export OMP_NUM_THREADS=8
export PYTHONUNBUFFERED=1
export WANDB_MODE=offline

# Resume is the default path, not the exception. A cold start and a restart
# run the same command; the difference lives in whether a checkpoint exists.
EXTRA_ARGS=()
if [ -n "${CONFIG:-}" ]; then
    EXTRA_ARGS+=(--config "configs/${CONFIG}")
fi
if [ -n "${STEPS:-}" ]; then
    EXTRA_ARGS+=(--steps "${STEPS}")
fi

set +e
python -m "$ENTRY" \
    "${EXTRA_ARGS[@]}" \
    --run-id "$RUN_ID" \
    --resume auto \
    --max-hours "$MAX_HOURS"
TRAIN_RC=$?
set -e

# Chain on anything short of the step budget, including a crash. afterany
# rather than afterok is deliberate: a job killed at the wall exits non
# zero, and that is precisely the case the chain exists to recover from.
# The DONE sentinel, not the exit code, decides whether we are finished.
if [ ! -f "runs/$RUN_ID/DONE" ]; then
    # Every variable that shaped this job must be forwarded, or the
    # successor silently runs with different settings. Forgetting MAX_HOURS
    # here is a particularly quiet bug: the successor would run to the full
    # 23 hours, the chain would appear to work, and the wall-clock stop
    # would never actually be exercised.
    CHAIN_VARS="RUN_ID=$RUN_ID,ENTRY=$ENTRY,MAX_HOURS=$MAX_HOURS"
    [ -n "${CONFIG:-}" ] && CHAIN_VARS="$CHAIN_VARS,CONFIG=$CONFIG"
    [ -n "${STEPS:-}" ]  && CHAIN_VARS="$CHAIN_VARS,STEPS=$STEPS"

    echo "run $RUN_ID incomplete (rc=$TRAIN_RC), queueing successor"
    echo "chain vars: $CHAIN_VARS"

    # This PBS server refuses qsub from inside a running job with
    # "Bad UID for job execution", so the successor is submitted by sshing
    # back to the login node, which is permitted and passwordless within
    # the cluster. The direct call is tried first so this script still
    # works on a server configured with flatuid. See docs/decisions.md
    # D-015.
    #
    # PBS_O_WORKDIR is on BeeGFS shared storage, so the path resolves
    # identically on the login node. That is what makes this work at all.
    CHAIN_QSUB="qsub -W depend=afterany:$PBS_JOBID -v $CHAIN_VARS scripts/submit.pbs"

    set +e
    $CHAIN_QSUB
    QSUB_RC=$?
    if [ $QSUB_RC -ne 0 ]; then
        echo "direct qsub failed (rc=$QSUB_RC), retrying via the login node"
        ssh -o BatchMode=yes -o StrictHostKeyChecking=no "$CHAIN_SUBMIT_HOST" \
            "cd '$PBS_O_WORKDIR' && $CHAIN_QSUB"
        QSUB_RC=$?
    fi
    set -e

    if [ $QSUB_RC -ne 0 ]; then
        echo "FATAL could not queue the successor for $RUN_ID. The chain is" >&2
        echo "broken and this run will not finish on its own. Investigate" >&2
        echo "before resubmitting, and do not assume it self-healed." >&2
        exit 1
    fi
else
    echo "run $RUN_ID has DONE, chain complete"
fi

exit $TRAIN_RC
